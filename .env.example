# --- Transmission connection --------------------------------------------------
# Base URL of your Transmission instance; "/transmission/rpc" is appended if you
# leave it off. Inside docker compose with the bundled Transmission service this
# is http://transmission:9091. For a Transmission on the Docker host use
# http://host.docker.internal:9091 (macOS/Windows) or the host's LAN address.
TRANSMISSION_URL=http://transmission:9091

# RPC credentials. Transmission ships with authentication off; setting these
# turns it on for the bundled container and tells the MCP server to use them.
# Set both or neither.
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

# HTTP timeout in seconds.
TRANSMISSION_TIMEOUT=30

# Set to false if Transmission uses HTTPS with a self-signed certificate.
TRANSMISSION_VERIFY_SSL=true

# Default download directory for add_torrent, as a path INSIDE the Transmission
# container. With the bundled service, /downloads maps to ./downloads here.
TRANSMISSION_DOWNLOAD_DIR=/downloads/complete

# --- Safety -------------------------------------------------------------------
# true registers only the read tools and search (no adding, removing or editing).
TRANSMISSION_READ_ONLY=false

# true lets remove_torrents delete the downloaded files from disk.
TRANSMISSION_ALLOW_REMOVE_DATA=false

# true additionally registers shutdown_session.
TRANSMISSION_ALLOW_SHUTDOWN=false

# --- Torrent search -----------------------------------------------------------
# false exposes Transmission control only, with no search tools.
SEARCH_ENABLED=true

# Comma-separated allowlist; empty means all. Available sources:
# thepiratebay, yts, nyaa, eztv, subsplease, fitgirl, bittorrented
SEARCH_SOURCES=

# Comma-separated denylist, applied on top of SEARCH_SOURCES.
SEARCH_EXCLUDE_SOURCES=

# Per-request timeout for indexers, in seconds.
SEARCH_TIMEOUT=20

# How long a search result stays cached so add_torrent can recover its name and
# trackers from an info hash, in seconds.
SEARCH_CACHE_TTL=900

# --- Bundled Transmission container -------------------------------------------
# Run "id -u" and "id -g" to match your own user, so downloaded files are yours.
PUID=1000
PGID=1000
TZ=UTC
TRANSMISSION_WEB_PORT=9091
TRANSMISSION_PEER_PORT=51413

# --- MCP server ---------------------------------------------------------------
# http (default) or stdio.
MCP_TRANSPORT=http
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=info
